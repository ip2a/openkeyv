# Whitelist mode: ignore everything by default, allow only what is listed
/*

!/.gitignore
!/.github/
!/rust/
!/python/
!/scripts/

# Docs are untracked for now
*.md
!README.md
!**/README.md

# Junk that still must be excluded inside the whitelist
# Rust
rust/target/

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
venv/
dist/
build/
*.whl
.pytest_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local environment
.env
.env.local
uv.lock
